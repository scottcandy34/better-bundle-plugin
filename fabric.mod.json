{
  "schemaVersion": 1,
  "id": "better_bundles",
  "version": "1.1",
  "name": "Better Bundles",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/better_bundles/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.bad_coders.better_bundles.client.Better_bundlesDataGenerator"
    ],
    "client": [
      "org.bad_coders.better_bundles.client.Better_bundlesClient"
    ],
    "main": [
      "org.bad_coders.better_bundles.BetterBundles"
    ]
  },
  "mixins": [
    "better_bundles.mixins.json",
    {
      "config": "better_bundles.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "fabric-resources": {
      "packs": [
        {
          "id": "bb_overrides",
          "displayName": "Better Bundles Overrides",
          "description": "Overrides vanilla translations",
          "path": "resourcepacks/better_bundles_overrides",
          "default": true
        }
      ]
    }
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "1.21.11"
  }
}
